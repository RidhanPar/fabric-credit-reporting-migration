# Local Spark test runner. Spark needs Hadoop winutils on Windows, so Spark tests run
# here (and natively on Linux in CI). Matches Fabric Runtime 1.3: Python 3.11, Spark 3.5, Delta 3.2.
FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 PYTHONDONTWRITEBYTECODE=1
WORKDIR /repo
COPY requirements.txt requirements-dev.txt requirements-spark.txt ./
RUN pip install --no-cache-dir -r requirements-spark.txt
# Warm the Delta jar cache so test runs work offline.
RUN python -c "from delta import configure_spark_with_delta_pip as c; from pyspark.sql import SparkSession as S; c(S.builder.master('local[1]')).getOrCreate().stop()"
CMD ["python", "-m", "pytest", "-q"]
