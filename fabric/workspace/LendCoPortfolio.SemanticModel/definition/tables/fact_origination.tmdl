/// One row per account, at the month end it was disbursed in.
table fact_origination
	lineageTag: 39b9b980-7209-528a-becd-da199324e572

	/// Accounts disbursed in the period, counted in the month the money left the building.
	measure 'New accounts' = COUNTROWS(fact_origination)
		formatString: #,0
		displayFolder: Origination
		lineageTag: 15157c85-1e58-5068-a933-4b247587f410

	/// Amount disbursed in the period, in EUR. A flow, so it is converted at the monthly average rate rather than the month end rate.
	measure 'New originations (EUR)' = SUM(fact_origination[amount_eur])
		formatString: #,0
		displayFolder: Origination
		lineageTag: cff320de-f5aa-507d-b45f-0fc6297463c4

	/// Average amount disbursed per new account.
	measure 'Avg loan size (EUR)' = DIVIDE([New originations (EUR)], [New accounts])
		formatString: #,0
		displayFolder: Origination
		lineageTag: b6f2c60a-dbb1-54bc-9cf8-f4648720a502

	column account_id
		dataType: string
		isHidden
