/// One row per credit application, in its current state.
table fact_application
	lineageTag: 4cdfcbdc-885f-525e-a907-a7dfd6d866b7

	/// Applications submitted in the period, whatever happened to them.
	measure 'Applications received' = COUNTROWS(fact_application)
		formatString: #,0
		displayFolder: Applications
		lineageTag: 3689aa11-ffb0-5b41-8cde-cb0f1955e1a6

	/// Applications that reached a credit decision: approved or declined. Withdrawn and incomplete applications are excluded.
	measure 'Applications decisioned' = CALCULATE(COUNTROWS(fact_application), fact_application[is_decisioned] = TRUE())
		formatString: #,0
		displayFolder: Applications
		lineageTag: 09c64e79-4ffb-54c6-88a8-1059195abbfe

	/// Applications approved in the period, counted by the month the application was submitted, so approvals line up with the demand that produced them.
	measure 'Applications approved' = CALCULATE(COUNTROWS(fact_application), fact_application[is_approved] = TRUE())
		formatString: #,0
		displayFolder: Applications
		lineageTag: 1421d9a0-a2d2-538b-8807-aecc5de5a555

	/// Approved as a share of decisioned applications. This is the definition agreed in the migration, because an application nobody decided says nothing about credit appetite.
	measure 'Approval rate' = DIVIDE([Applications approved], [Applications decisioned])
		formatString: 0.0%
		displayFolder: Applications
		lineageTag: b2b664e2-1b9c-5332-9193-737086f98d3e

	/// The legacy definition: approved over everything received, including withdrawn and incomplete. Kept for the parallel run, and it reads about 5 points lower.
	measure 'Approval rate (legacy definition)' = DIVIDE([Applications approved], [Applications received])
		formatString: 0.0%
		displayFolder: Migration
		lineageTag: f061cd5b-55d2-5ac6-bfde-623cb082bb89

	column application_id
		dataType: string
		isHidden
