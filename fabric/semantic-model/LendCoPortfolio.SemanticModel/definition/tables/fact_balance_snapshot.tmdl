/// One row per account per month end. The balance measures are semi additive.
table fact_balance_snapshot
	lineageTag: 0b7a91bb-21e1-5cb0-88e7-781f5cd0780e

	/// Balance of active accounts in EUR at a month end, converted at that month's closing rate. A balance is a stock, so over a longer period this reports the latest month end in the period rather than a sum of month ends.
	measure 'Portfolio balance (EUR)' = LASTNONBLANKVALUE(dim_date[date_key], CALCULATE(SUM(fact_balance_snapshot[balance_eur]), fact_balance_snapshot[is_active] = TRUE()))
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: 05756482-8264-5313-beca-042d0d9be8b0

	/// The portfolio balance one month earlier, used by the growth measure. Time intelligence like this only works because dim_date is marked as the model's date table.
	measure 'Portfolio balance last month (EUR)' = CALCULATE([Portfolio balance (EUR)], DATEADD(dim_date[date], -1, MONTH))
		formatString: #,0
		isHidden
		displayFolder: Portfolio
		lineageTag: 28f5811b-790f-5f91-98a1-7bb95af4c934

	/// Month on month growth of the portfolio balance.
	measure 'Portfolio balance MoM %' = DIVIDE([Portfolio balance (EUR)] - [Portfolio balance last month (EUR)], [Portfolio balance last month (EUR)])
		formatString: 0.0%
		displayFolder: Portfolio
		lineageTag: eb2b1d04-aec2-53e3-af08-060b200ba8cd

	/// Accounts with an active status at a month end. Semi additive, like the balance.
	measure 'Active accounts' = LASTNONBLANKVALUE(dim_date[date_key], CALCULATE(COUNTROWS(fact_balance_snapshot), fact_balance_snapshot[is_active] = TRUE()))
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: e7631cfc-f119-51c6-bcb2-4a294d9d6255

	/// Distinct customers holding at least one active account at a month end. A customer with a loan and a card counts once.
	measure 'Active customers' = LASTNONBLANKVALUE(dim_date[date_key], CALCULATE(DISTINCTCOUNT(fact_balance_snapshot[customer_id]), fact_balance_snapshot[is_active] = TRUE()))
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: f1253d0e-ce24-5a2b-8f74-ea80dfa1130e

	/// Portfolio balance divided by distinct active customers. This is the definition agreed in the migration. The legacy pack divided by active accounts, which is a different number.
	measure 'Avg balance per customer (EUR)' = DIVIDE([Portfolio balance (EUR)], [Active customers])
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: 87cb1725-019a-5136-8e2d-df27e5054efc

	/// The legacy definition of average balance, kept so the old and new figures can be compared during the parallel run.
	measure 'Avg balance per account (EUR)' = DIVIDE([Portfolio balance (EUR)], [Active accounts])
		formatString: #,0
		displayFolder: Migration
		lineageTag: 2fec3c14-79a3-50a7-bb32-5ae9ddbd5ff1

	/// Balance of active accounts 30 or more days past due, at a month end.
	measure 'Balance 30+ DPD (EUR)' = LASTNONBLANKVALUE(dim_date[date_key], CALCULATE(SUM(fact_balance_snapshot[balance_eur]), fact_balance_snapshot[is_dpd30] = TRUE()))
		formatString: #,0
		displayFolder: Credit quality
		lineageTag: ae83bd1f-7a24-5f5a-925c-3ad31b63d467

	/// Balance 30 or more days past due as a share of the active portfolio balance. A balance weighted rate, not an account count rate, because it is the money at risk that matters for impairment.
	measure '30+ DPD rate' = DIVIDE([Balance 30+ DPD (EUR)], [Portfolio balance (EUR)])
		formatString: 0.00%
		displayFolder: Credit quality
		lineageTag: 4f486655-2e16-56d1-9250-82985f07f1cc

	/// Balance of active accounts 90 or more days past due, at a month end. Accounts are written off at 180 days, so they leave this measure then.
	measure 'Balance 90+ DPD (EUR)' = LASTNONBLANKVALUE(dim_date[date_key], CALCULATE(SUM(fact_balance_snapshot[balance_eur]), fact_balance_snapshot[is_dpd90] = TRUE()))
		formatString: #,0
		displayFolder: Credit quality
		lineageTag: 9fd159bf-f54a-5cb5-8a24-ef0e4df9abe5

	/// Balance 90 or more days past due as a share of the active portfolio balance.
	measure '90+ DPD rate' = DIVIDE([Balance 90+ DPD (EUR)], [Portfolio balance (EUR)])
		formatString: 0.00%
		displayFolder: Credit quality
		lineageTag: d882e79f-a0db-5d40-861c-738271b0f271

	/// The 30+ rate one month earlier, used by the change measure. Hidden, because a report author should pick the change measure rather than build the subtraction again.
	measure '30+ DPD rate last month' = CALCULATE([30+ DPD rate], DATEADD(dim_date[date], -1, MONTH))
		formatString: 0.00%
		isHidden
		displayFolder: Credit quality
		lineageTag: 00e053d4-a65f-5604-beb6-283a39ff4320

	/// Change in the 30+ rate against the previous month, in percentage points.
	measure '30+ DPD rate change' = [30+ DPD rate] - [30+ DPD rate last month]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Credit quality
		lineageTag: e0ab179e-a8e5-5ab0-94be-82433a458447

